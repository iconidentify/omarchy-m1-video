        "lines": "1006-1025",
        "sha256": "065e2343426559569b44aa39d16a7ff2bd780e65003874093fddc17b9c07e1a4"
      }
    },
    {
      "id": "scratch_from_coded_fmt",
      "kind": "source_observed",
      "text": "Scratch buffers are sized from the coded OUTPUT format and bit depth, not from a per-buffer wrapper.",
      "cite": {

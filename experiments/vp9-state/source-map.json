    {
      "id": "image_fmt_busy",
      "kind": "source_observed",
      "text": "A bit-depth/image-format change through avd_s_ctrl requires an idle CAPTURE queue.",
      "cite": {
        "file": "drivers/media/platform/apple/avd/avd-v4l2.c",
        "lines": "139-143",
        "sha256": "2d1c3fc727d0427fcc0147c8f6f24367dfeb0851838bc093559a9c0630503c53"
      }
    },
    {
      "id": "no_destination_fallback",
      "kind": "proposed_contract",
      "text": "A declared reference that does not resolve is a submission error. There is no self-reference fallback."
    },
    {
      "id": "generation_scoped_timestamps",
      "kind": "proposed_contract",
      "text": "Timestamps are scoped by CAPTURE queue generation. Index-derived timestamps must not alias older content after REQBUFS(0)."
    },
    {
      "id": "explicit_ref_registration",
      "kind": "proposed_contract",
      "text": "An imported backing is usable as a reference only after explicit registration of generation, index, timestamp and immutable era metadata."
    },
    {
      "id": "ref_not_queued_as_dst",
      "kind": "proposed_contract",
      "text": "A still-live reference must not be queued as a decode destination."
    },
    {
      "id": "era_sizing_dst_vs_ref",
      "kind": "proposed_contract",
      "text": "The destination must meet the current era sizeimage; a reference must meet its own era sizeimage."
    },
    {
      "id": "failed_session_no_submit",
      "kind": "proposed_contract",
      "text": "After a destructive reconfigure phase fails, the session is marked failed and further submissions are forbidden until a verified restore exists."
    },
    {
      "id": "session_not_profile_key",
      "kind": "proposed_contract",
      "text": "Device and profile are compatibility filters, never a session key for inheriting entropy or references."
    },
    {
      "id": "firmware_live_resize",
      "kind": "firmware_unknown",
      "text": "Whether firmware accepts a per-frame dimension change on a continuing context with prior-era references is experiment A. A passing model is not that result."
    },
    {
      "id": "firmware_seg_map",
      "kind": "firmware_unknown",
      "text": "Segment-map preserve-versus-reset policy across a resize is experiment B."
    },
    {
      "id": "firmware_scratch_regrow",
      "kind": "firmware_unknown",
      "text": "Whether scratch can be resized on a live OUTPUT stream is experiment C."
    },
    {
      "id": "firmware_mixed_era_comp",
      "kind": "firmware_unknown",
      "text": "Whether mixed-era compressed-reference offsets are read correctly is experiment D."
    },
    {
      "id": "firmware_rev3_vs_rev4",
      "kind": "firmware_unknown",
      "text": "M1 (rev 3) versus M2 (rev 4) divergence is experiment E."
    },
    {
      "id": "both_queues_streaming",
      "kind": "source_observed",
      "text": "The mem2mem scheduler does not run a decode job before both queues stream; AVD does not opt into ignore_cap_streaming. A model decode means completed work, not merely a queued request.",
      "cite": {
        "file": "drivers/media/v4l2-core/v4l2-mem2mem.c",
        "lines": "294-308",
        "sha256": "8cba59ee8aec8d14f7f2b0c81829fe188d25c99399de613f3d23a5cf5eb95854"
      }
    },
    {
      "id": "reqbufs_replaces_queue",
      "kind": "source_observed",
      "text": "REQBUFS rejects a streaming queue. With existing buffers, both zero and positive-count REQBUFS cancel/free the old queue before returning or allocating replacements.",
      "cite": {
        "file": "drivers/media/common/videobuf2/videobuf2-core.c",
        "lines": "867-916",
        "sha256": "86222aaa61047a3ac9ecefec2f1ed4a9c3392026120009c59e862767c4618228"
      }
    },
    {
      "id": "scratch_capacity_contract",
      "kind": "proposed_contract",
      "text": "Reject a modeled completed decode whose bit depth or ceil-divided 8/16/64-pixel geometry exceeds the scratch allocation. The allocation formulas are source-observed; this extra checker guard is not a claim that stock AVD rejects it.",
      "cite": {
        "file": "drivers/media/platform/apple/avd/avd-vp9.c",
        "lines": "654-728",
        "sha256": "065e2343426559569b44aa39d16a7ff2bd780e65003874093fddc17b9c07e1a4"
      }
    },
    {
      "id": "unique_destination_slot",
      "kind": "proposed_contract",
      "text": "One live destination backing occupies one slot; a second queue event must not silently create an alias or overwrite another wrapper."
    }
  ]
}

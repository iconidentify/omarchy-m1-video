+
+#include <stdatomic.h>
+
+/* A finite monotonic deadline covers lock contention as well as poll. */
+static int observer_lock_until(pthread_mutex_t *mutex, uint64_t deadline)
+{
+	for (;;) {
+		if (v4l2r_now_ns() >= deadline)
+			return -ETIMEDOUT;
+		int err = pthread_mutex_trylock(mutex);
+		if (!err)
+			return 0;
+		if (err != EBUSY)
+			return -err;
+		struct timespec pause = { .tv_nsec = 100000 };
+		nanosleep(&pause, NULL);
+	}
+}
+
+VAStatus v4l2r_observer_enable(struct v4l2r_context *ctx)
+{
+	static _Atomic uint64_t next_run;
+	static _Atomic uint64_t next_ctx;
+
+	if (!ctx)
+		return VA_STATUS_ERROR_INVALID_PARAMETER;
+	pthread_mutex_lock(&ctx->mutex);
+	if (!ctx->observer_enabled) {
+		ctx->observer_enabled = 1;
+		if (!ctx->observer_run_generation)
+			ctx->observer_run_generation =
+				atomic_fetch_add(&next_run, 1) + 1;
+		if (!ctx->observer_context_id)
+			ctx->observer_context_id =
+				atomic_fetch_add(&next_ctx, 1) + 1;
+	}
+	pthread_mutex_unlock(&ctx->mutex);
+	return VA_STATUS_SUCCESS;
+}
+
+VAStatus v4l2r_observer_begin(struct v4l2r_context *ctx, uint64_t deadline_ns,
+			      struct v4l2r_observer_receipt *out)
+{
+	int ret = 0;
+	int capture_index = -1;
+
+	if (!ctx || !ctx->observer_enabled)
+		return VA_STATUS_ERROR_UNIMPLEMENTED;
+	if (!out)
+		return VA_STATUS_ERROR_INVALID_PARAMETER;
+	if (!deadline_ns)
+		deadline_ns = v4l2r_now_ns() + (uint64_t)V4L2R_POLL_TIMEOUT_MS * 1000000;
+	if (observer_lock_until(&ctx->mutex, deadline_ns) < 0)
+		return VA_STATUS_ERROR_OPERATION_FAILED;
+	if (v4l2r_now_ns() >= deadline_ns) {
+		pthread_mutex_unlock(&ctx->mutex);
+		return VA_STATUS_ERROR_OPERATION_FAILED;
+	}
+	/* Partial pictures and other writers cannot establish this barrier. */
+	if (ctx->failed || ctx->observer_paused || ctx->in_picture ||
+	    ctx->conv || ctx->vpp ||
+	    ctx->capture_memory == V4L2_MEMORY_DMABUF) {
+		pthread_mutex_unlock(&ctx->mutex);
+		return VA_STATUS_ERROR_OPERATION_FAILED;
+	}
+	if (!ctx->streaming && ctx->submitted > ctx->completed) {
+		pthread_mutex_unlock(&ctx->mutex);
+		return VA_STATUS_ERROR_OPERATION_FAILED;
+	}
+	ctx->observer_paused = 1;
+	ctx->observer_retain = 1;
+	if (ctx->streaming && ctx->completed < ctx->submitted)
+		ret = wait_completed_locked(ctx, ctx->submitted, deadline_ns);
+	if (ret < 0 || v4l2r_now_ns() >= deadline_ns) {
+		ctx->observer_paused = 0;
+		ctx->observer_retain = 0;
+		pthread_mutex_unlock(&ctx->mutex);
+		return VA_STATUS_ERROR_OPERATION_FAILED;
+	}
+	if (ctx->pic.target)
+		capture_index = ctx->pic.target->capture_index;
+	out->run_generation = ctx->observer_run_generation;
+	out->context_generation = ctx->observer_context_id;
+	out->submitted = ctx->submitted;
+	out->completed = ctx->completed;
+	out->queued_capture = ctx->queued_capture;
+	out->capture_index = capture_index < 0 ? 0 : (uint32_t)capture_index;
+	out->last_ref_seq = 0;
+	if (capture_index >= 0 &&
+	    (unsigned int)capture_index < ctx->nb_captures)
+		out->last_ref_seq = ctx->captures[capture_index].last_ref_seq;
+	pthread_mutex_unlock(&ctx->mutex);
+	return VA_STATUS_SUCCESS;
+}
+
+VAStatus v4l2r_observer_end(struct v4l2r_context *ctx)
+{
+	if (!ctx || !ctx->observer_enabled)
+		return VA_STATUS_ERROR_UNIMPLEMENTED;
+	pthread_mutex_lock(&ctx->mutex);
+	if (!ctx->observer_paused) {
+		pthread_mutex_unlock(&ctx->mutex);
+		return VA_STATUS_ERROR_OPERATION_FAILED;
+	}
+	ctx->observer_paused = 0;
+	ctx->observer_retain = 0;
+	pthread_mutex_unlock(&ctx->mutex);
+	return VA_STATUS_SUCCESS;
+}
+
+VAStatus v4l2r_observer_teardown(struct v4l2r_context *ctx)
+{
+	if (!ctx || !ctx->observer_enabled)
+		return VA_STATUS_ERROR_UNIMPLEMENTED;
+	pthread_mutex_lock(&ctx->mutex);
+	if (ctx->observer_retain) {
+		pthread_mutex_unlock(&ctx->mutex);
+		return VA_STATUS_ERROR_OPERATION_FAILED;
+	}
+	ctx->observer_enabled = 0;
+	ctx->observer_paused = 0;
+	pthread_mutex_unlock(&ctx->mutex);
+	return VA_STATUS_SUCCESS;
+}
+
+/* Public experimental wrappers follow api_mutex -> handle table -> ctx.
+ * Raw context helpers above are internal and require API serialization. */
+static VAStatus observer_by_id(VADriverContextP va, VAContextID id,
+                              uint64_t deadline, int operation,
+                              struct v4l2r_observer_receipt *out)
+{
+	if (!va || !va->pDriverData)
+		return VA_STATUS_ERROR_INVALID_CONTEXT;
+	struct v4l2r_driver *drv = v4l2r_driver(va);
+	if (!deadline)
+		deadline = v4l2r_now_ns() + (uint64_t)V4L2R_POLL_TIMEOUT_MS * 1000000;
+	if (observer_lock_until(&drv->api_mutex, deadline) < 0)
+		return VA_STATUS_ERROR_OPERATION_FAILED;
+	struct v4l2r_context *ctx = V4L2R_CONTEXT_GET(drv, id);
+	VAStatus status = VA_STATUS_ERROR_INVALID_CONTEXT;
+	if (ctx) {
+		switch (operation) {
+		case 0: status = v4l2r_observer_enable(ctx); break;
+		case 1: status = v4l2r_observer_begin(ctx, deadline, out); break;
+		case 2: status = v4l2r_observer_end(ctx); break;
+		case 3: status = v4l2r_observer_teardown(ctx); break;
+		}
+	}
+	pthread_mutex_unlock(&drv->api_mutex);
+	return status;
+}
+
+VAStatus v4l2r_observer_enable_id(VADriverContextP va, VAContextID id)
+{
+	return observer_by_id(va, id, 0, 0, NULL);
+}
+
+VAStatus v4l2r_observer_begin_id(VADriverContextP va, VAContextID id,
+                                 uint64_t deadline_ns,
+                                 struct v4l2r_observer_receipt *out)
+{
+	return observer_by_id(va, id, deadline_ns, 1, out);
+}
+
+VAStatus v4l2r_observer_end_id(VADriverContextP va, VAContextID id)
+{
+	return observer_by_id(va, id, 0, 2, NULL);
+}
+
+VAStatus v4l2r_observer_teardown_id(VADriverContextP va, VAContextID id)
+{
+	return observer_by_id(va, id, 0, 3, NULL);
+}

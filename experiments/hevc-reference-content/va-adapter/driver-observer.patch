 static int dequeue_completed_buffers(struct v4l2r_context *ctx,
 				      enum v4l2_buf_type type)
 {
@@ -681,6 +707,8 @@ static VAStatus queue_decode(struct v4l2r_context *ctx,
 	}
 
 	ctx->queued_request |= 1u << output->index;
+	if (last_slice)
+		ctx->captures[target->capture_index].observer_writer = ctx->submitted;
 	target->status = VASurfaceRendering;
 

diff --git i/src/observer.c w/src/observer.c
new file mode 100644
index 0000000..c6ebe8a
--- /dev/null
+++ w/src/observer.c
@@ -0,0 +1,264 @@
+/* SPDX-License-Identifier: GPL-3.0-or-later */
+#include <errno.h>
+#include <string.h>
+#include <sys/random.h>
+#include <time.h>
+#include "v4l2_request.h"
+
+#define WINDOW_NS UINT64_C(2000000000)
+#define REFUSED VA_STATUS_ERROR_OPERATION_FAILED
+static _Thread_local uint64_t owner_generation;
+
+/* Saturate instead of permitting generation/nonce ABA on integer wrap. */
+uint64_t v4l2r_observer_generation(void)
+{
+	static _Atomic uint64_t next = 1;
+	uint64_t value = atomic_load(&next);
+	while (value && !atomic_compare_exchange_weak(&next, &value,
+		value == UINT64_MAX ? 0 : value + 1)) {}
+	return value;
+}
+
+/* Called at actual context creation under api_mutex; randomness is a run
+ * identifier, not an authorization secret. Failure disables observation. */
+void v4l2r_observer_init_run(struct v4l2r_driver *drv)
+{
+	if (drv->observer_run[0] || drv->observer_run[1])
+		return;
+	uint64_t run[2];
+	if (getrandom(run, sizeof(run), GRND_NONBLOCK) == sizeof(run))
+		memcpy(drv->observer_run, run, sizeof(run));
+}
+
+static int lock_until(pthread_mutex_t *mutex, uint64_t deadline)
+{
+	for (;;) {
+		if (v4l2r_now_ns() >= deadline)
+			return -ETIMEDOUT;
+		int ret = pthread_mutex_trylock(mutex);
+		if (!ret)
+			return 0;
+		if (ret != EBUSY)
+			return -ret;
+		struct timespec delay = {.tv_nsec = 100000};
+		nanosleep(&delay, NULL);
+	}
+}
+
+static struct v4l2r_context *session_context(struct v4l2r_driver *drv,
+	const struct v4l2r_observer_session *session)
+{
+	if (!session || !session->nonce ||
+	    memcmp(session->run, drv->observer_run, sizeof(session->run)))
+		return NULL;
+	struct v4l2r_context *ctx = V4L2R_CONTEXT_GET(drv, session->context);
+	if (!ctx || ctx->observer_generation != session->context_generation ||
+	    ctx->observer_session != session->nonce ||
+	    !owner_generation || ctx->observer_owner_generation != owner_generation ||
+	    !pthread_equal(ctx->observer_owner, pthread_self()))
+		return NULL;
+	return ctx;
+}
+
+static void session_record(struct v4l2r_context *ctx,
+	struct v4l2r_observer_session *session)
+{
+	*session = (struct v4l2r_observer_session) {
+		.run = {ctx->drv->observer_run[0], ctx->drv->observer_run[1]},
+		.context = ctx->id, .context_generation = ctx->observer_generation,
+		.nonce = ctx->observer_session,
+	};
+}
+
+/* No ioctl, hidden flush, conversion or allocation here. Sticky alias state
+ * covers exported FDs and derived maps even after the VA object is destroyed. */
+static struct v4l2r_capture_buffer *selected(struct v4l2r_context *ctx,
+	VASurfaceID id, struct v4l2r_observer_target *target)
+{
+	struct v4l2r_surface *s = V4L2R_SURFACE_GET(ctx->drv, id);
+	if (!s || s->ctx != ctx || !s->observer_generation || s->observer_aliased ||
+	    s->backing || s->convert_pending || s->image_refs ||
+	    s->decode_status != VA_STATUS_SUCCESS || s->capture_index < 0 ||
+	    (unsigned)s->capture_index >= ctx->nb_captures)
+		return NULL;
+	struct v4l2r_capture_buffer *cap = &ctx->captures[s->capture_index];
+	if (cap->surface != s || !cap->observer_generation || !cap->observer_writer ||
+	    cap->observer_aliased || !cap->nb_planes || cap->nb_planes > VIDEO_MAX_PLANES)
+		return NULL;
+	*target = (struct v4l2r_observer_target) {
+		.surface = id, .surface_generation = s->observer_generation,
+		.allocation_generation = cap->observer_generation, .writer = cap->observer_writer,
+	};
+	return cap;
+}
+
+VAStatus v4l2r_observer_open(VADriverContextP va, VAContextID id,
+	struct v4l2r_observer_session *session)
+{
+	if (!va || !va->pDriverData || !session)
+		return VA_STATUS_ERROR_INVALID_PARAMETER;
+	struct v4l2r_driver *drv = v4l2r_driver(va);
+	int cancel;
+	pthread_setcancelstate(PTHREAD_CANCEL_DISABLE, &cancel);
+	VAStatus ret = REFUSED;
+	if (!lock_until(&drv->api_mutex, v4l2r_now_ns() + WINDOW_NS)) {
+		struct v4l2r_context *ctx = V4L2R_CONTEXT_GET(drv, id);
+		if (!drv->observer_active && ctx && ctx->observer_generation &&
+		    !ctx->observer_session && (drv->observer_run[0] || drv->observer_run[1])) {
+			if (!owner_generation)
+				owner_generation = v4l2r_observer_generation();
+			ctx->observer_owner_generation = owner_generation;
+			ctx->observer_session = owner_generation ? v4l2r_observer_generation() : 0;
+			ctx->observer_owner = pthread_self();
+			if (ctx->observer_session) {
+				session_record(ctx, session);
+				ret = VA_STATUS_SUCCESS;
+			}
+		}
+		pthread_mutex_unlock(&drv->api_mutex);
+	}
+	pthread_setcancelstate(cancel, NULL);
+	return ret;
+}
+
+VAStatus v4l2r_observer_select(VADriverContextP va,
+	const struct v4l2r_observer_session *session, VASurfaceID id,
+	struct v4l2r_observer_target *target)
+{
+	if (!va || !va->pDriverData || !target)
+		return VA_STATUS_ERROR_INVALID_PARAMETER;
+	struct v4l2r_driver *drv = v4l2r_driver(va);
+	int cancel;
+	pthread_setcancelstate(PTHREAD_CANCEL_DISABLE, &cancel);
+	VAStatus ret = REFUSED;
+	if (!lock_until(&drv->api_mutex, v4l2r_now_ns() + WINDOW_NS)) {
+		struct v4l2r_context *ctx = session_context(drv, session);
+		if (ctx && !drv->observer_active && selected(ctx, id, target))
+			ret = VA_STATUS_SUCCESS;
+		pthread_mutex_unlock(&drv->api_mutex);
+	}
+	pthread_setcancelstate(cancel, NULL);
+	return ret;
+}
+
+VAStatus v4l2r_observer_begin(VADriverContextP va,
+	const struct v4l2r_observer_session *session,
+	const struct v4l2r_observer_target *target, uint64_t deadline,
+	struct v4l2r_observer_receipt *receipt)
+{
+	if (!va || !va->pDriverData || !target || !receipt)
+		return VA_STATUS_ERROR_INVALID_PARAMETER;
+	uint64_t now = v4l2r_now_ns();
+	if (!deadline)
+		deadline = now + WINDOW_NS;
+	if (deadline <= now || deadline - now > WINDOW_NS)
+		return REFUSED;
+	struct v4l2r_driver *drv = v4l2r_driver(va);
+	int cancel;
+	pthread_setcancelstate(PTHREAD_CANCEL_DISABLE, &cancel);
+	VAStatus ret = REFUSED;
+	if (lock_until(&drv->api_mutex, deadline))
+		goto restore;
+	struct v4l2r_context *ctx = session_context(drv, session);
+	if (!ctx || drv->observer_active)
+		goto unlock;
+	/* This first adapter supports a sole decoder on the display. Reject
+	 * cross-context, VPP, imported and conversion producers explicitly. */
+	unsigned iter = 0, count = 0;
+	uint32_t id;
+	while (v4l2r_handles_next(&drv->contexts, &iter, &id))
+		count++;
+	if (count != 1 || ctx->in_picture || ctx->failed || ctx->conv || ctx->vpp ||
+	    ctx->observer_sequence_exhausted ||
+	    !ctx->streaming || ctx->capture_memory != V4L2_MEMORY_MMAP)
+		goto unlock;
+	if (lock_until(&ctx->mutex, deadline))
+		goto unlock;
+	struct v4l2r_observer_target actual;
+	struct v4l2r_capture_buffer *cap = selected(ctx, target->surface, &actual);
+	if (!cap || actual.surface_generation != target->surface_generation ||
+	    actual.allocation_generation != target->allocation_generation ||
+	    actual.writer != target->writer)
+		goto unlock_context;
+	/* api_mutex already stops every supported producer/destructor. Only
+	 * after all issued CAPTURE readers drain does the pin escape the lock. */
+	if (v4l2r_observer_drain_locked(ctx, deadline) < 0) {
+		v4l2r_context_fail(ctx);
+		goto unlock_context;
+	}
+	for (unsigned i = 0; i < ctx->nb_captures; i++)
+		if (ctx->captures[i].surface &&
+		    ctx->captures[i].surface->decode_status != VA_STATUS_SUCCESS)
+			goto unlock_context;
+	if (!selected(ctx, target->surface, &actual) ||
+	    cap->observer_completed_writer != target->writer ||
+	    cap->last_ref_seq > ctx->completed || v4l2r_now_ns() >= deadline)
+		goto unlock_context;
+	uint64_t lease = v4l2r_observer_generation();
+	if (!lease)
+		goto unlock_context;
+	ctx->observer_lease = lease;
+	ctx->observer_cancel_state = cancel;
+	drv->observer_active = ctx;
+	memset(receipt, 0, sizeof(*receipt));
+	session_record(ctx, &receipt->session);
+	receipt->target = actual;
+	receipt->lease = lease;
+	receipt->submitted = ctx->submitted;
+	receipt->completed = ctx->completed;
+	receipt->last_reference = cap->last_ref_seq;
+	receipt->capture_index = (uint32_t)(cap - ctx->captures);
+	receipt->planes = cap->nb_planes;
+	for (unsigned i = 0; i < cap->nb_planes; i++)
+		receipt->plane_size[i] = cap->plane_size[i];
+	ret = VA_STATUS_SUCCESS;
+unlock_context:
+	pthread_mutex_unlock(&ctx->mutex);
+unlock:
+	pthread_mutex_unlock(&drv->api_mutex);
+restore:
+	/* A pending deferred cancellation can only run after all pins/locks
+	 * are released. Success leaves cancellation disabled until end. */
+	if (ret != VA_STATUS_SUCCESS)
+		pthread_setcancelstate(cancel, NULL);
+	return ret;
+}
+
+static VAStatus finish(VADriverContextP va,
+	const struct v4l2r_observer_session *session, uint64_t lease, bool close)
+{
+	if (!va || !va->pDriverData)
+		return VA_STATUS_ERROR_INVALID_PARAMETER;
+	struct v4l2r_driver *drv = v4l2r_driver(va);
+	int cancel;
+	pthread_setcancelstate(PTHREAD_CANCEL_DISABLE, &cancel);
+	VAStatus ret = REFUSED;
+	if (!lock_until(&drv->api_mutex, v4l2r_now_ns() + WINDOW_NS)) {
+		struct v4l2r_context *ctx = session_context(drv, session);
+		if (ctx && close && !drv->observer_active) {
+			ctx->observer_session = 0;
+			ret = VA_STATUS_SUCCESS;
+		} else if (ctx && !close && lease && drv->observer_active == ctx &&
+			   ctx->observer_lease == lease) {
+			drv->observer_active = NULL;
+			ctx->observer_lease = 0;
+			cancel = ctx->observer_cancel_state;
+			ret = VA_STATUS_SUCCESS;
+		}
+		pthread_mutex_unlock(&drv->api_mutex);
+	}
+	pthread_setcancelstate(cancel, NULL);
+	return ret;
+}
+
+VAStatus v4l2r_observer_end(VADriverContextP va,
+	const struct v4l2r_observer_session *session, uint64_t lease)
+{
+	return finish(va, session, lease, false);
+}
+
+VAStatus v4l2r_observer_close(VADriverContextP va,
+	const struct v4l2r_observer_session *session)
+{
+	return finish(va, session, 0, true);
+}
diff --git i/src/observer.h w/src/observer.h
new file mode 100644
index 0000000..195c524
--- /dev/null
+++ w/src/observer.h
@@ -0,0 +1,48 @@
+/* SPDX-License-Identifier: GPL-3.0-or-later */
+/* Experimental, opt-in metadata-only observer. See companion CONTRACT.md.
+ * Public functions take the actual driver's VADriverContextP (not VADisplay).
+ * These are not libva ABI extensions and are not a CPU-coherence/copy API. */
+#ifndef V4L2R_OBSERVER_H
+#define V4L2R_OBSERVER_H
+#include <stdint.h>
+#include <linux/videodev2.h>
+#include <va/va_backend.h>
+struct v4l2r_driver;
+struct v4l2r_context;
+struct v4l2r_observer_session {
+	uint64_t run[2], context_generation, nonce;
+	VAContextID context;
+};
+struct v4l2r_observer_target {
+	VASurfaceID surface;
+	uint64_t surface_generation, allocation_generation, writer;
+};
+struct v4l2r_observer_receipt {
+	struct v4l2r_observer_session session;
+	struct v4l2r_observer_target target;
+	uint64_t lease, submitted, completed, last_reference;
+	uint32_t capture_index, planes;
+	uint64_t plane_size[VIDEO_MAX_PLANES];
+};
+#define V4L2R_OBSERVER_API __attribute__((visibility("default")))
+V4L2R_OBSERVER_API VAStatus v4l2r_observer_open(VADriverContextP va, VAContextID id,
+	struct v4l2r_observer_session *session);
+V4L2R_OBSERVER_API VAStatus v4l2r_observer_select(VADriverContextP va,
+	const struct v4l2r_observer_session *session, VASurfaceID id,
+	struct v4l2r_observer_target *target);
+/* Zero deadline means now + 2s; nonzero is absolute CLOCK_MONOTONIC ns and
+ * may not exceed now + 2s. Success disables cancellation on the owner until
+ * matching end. No raw pointers, FDs, mapping or coherence claim is returned. */
+V4L2R_OBSERVER_API VAStatus v4l2r_observer_begin(VADriverContextP va,
+	const struct v4l2r_observer_session *session,
+	const struct v4l2r_observer_target *target, uint64_t deadline,
+	struct v4l2r_observer_receipt *receipt);
+V4L2R_OBSERVER_API VAStatus v4l2r_observer_end(VADriverContextP va,
+	const struct v4l2r_observer_session *session, uint64_t lease);
+V4L2R_OBSERVER_API VAStatus v4l2r_observer_close(VADriverContextP va,
+	const struct v4l2r_observer_session *session);
+/* Internal: real creation/queue transitions, independent of observer enable. */
+uint64_t v4l2r_observer_generation(void);
+void v4l2r_observer_init_run(struct v4l2r_driver *drv);
+int v4l2r_observer_drain_locked(struct v4l2r_context *ctx, uint64_t deadline);
+#endif

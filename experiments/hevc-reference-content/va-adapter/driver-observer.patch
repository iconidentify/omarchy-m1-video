+/* Experimental default-off observer (companion omarchy-m1-video #95).
+ * Production contexts leave observer_enabled=0. */
+struct v4l2r_observer_receipt {
+	uint64_t run_generation;
+	uint64_t context_generation;
+	uint64_t submitted;
+	uint64_t completed;
+	uint32_t capture_index;
+	uint64_t last_ref_seq;
+	uint64_t queued_capture;
+};
+VAStatus v4l2r_observer_enable(struct v4l2r_context *ctx);
+VAStatus v4l2r_observer_begin(struct v4l2r_context *ctx, uint64_t deadline_ns,
+			      struct v4l2r_observer_receipt *out);
+VAStatus v4l2r_observer_end(struct v4l2r_context *ctx);
+VAStatus v4l2r_observer_teardown(struct v4l2r_context *ctx);
+

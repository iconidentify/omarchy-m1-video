+/* Observer holds api_mutex then ctx->mutex. All issued CAPTURE readers
+ * must finish; output consumption alone cannot establish reference quiescence.
+ * Use the same absolute deadline for every dequeue/retry/poll. */
+int v4l2r_observer_drain_locked(struct v4l2r_context *ctx, uint64_t deadline)
+{
+	while (ctx->queued_capture) {
+		if (v4l2r_now_ns() >= deadline)
+			return -ETIMEDOUT;
+		int ret = dequeue_buffer(ctx, ctx->capture_format.type);
+		if (ret == -EINTR)
+			continue;
+		if (ret == -EAGAIN)
+			ret = v4l2r_poll_until(ctx->video_fd, POLLIN, deadline);
+		if (ret < 0)
+			return ret;
+	}
+	return ctx->completed == ctx->submitted ? 0 : -EIO;
+}

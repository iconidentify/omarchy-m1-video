+/* Freeze the complete runner configuration while source allocation is still
+ * negotiable.  The returned total is the ordinary decoder requirement plus
+ * one never-published allocation for every selected output. */
+static gboolean
+gst_hevc_runner_allocation_size (GstV4l2CodecH265Dec * self,
+    guint ordinary, guint * total)
+{
+  gboolean ok = TRUE;
+
+  g_return_val_if_fail (total, FALSE);
+  *total = ordinary;
+  GST_VIDEO_DECODER_STREAM_LOCK (self);
+  GstHevcRunner *runner = self->content_runner;
+  if (!runner)
+    goto done;
+  if (runner->allocation_frozen) {
+    ok = runner->count <= G_MAXUINT - ordinary;
+    if (ok)
+      *total = ordinary + runner->count;
+    goto done;
+  }
+  runner->locked = TRUE;
+  if (runner->invalid || runner->set_mask != GST_HEVC_RUNNER_SET_ALL ||
+      !gst_hevc_runner_parse_frames (runner) ||
+      !runner->report_path || !*runner->report_path ||
+      runner->count > G_MAXUINT - ordinary) {
+    gst_hevc_runner_message (self, GST_HEVC_RUNNER_CONFIG_REFUSED, TRUE);
+    ok = FALSE;
+    goto done;
+  }
+  runner->allocation_frozen = TRUE;
+  runner->allocated_mask = 0;
+  runner->remaining_allocations = runner->count;
+  *total = ordinary + runner->count;
+done:
+  GST_VIDEO_DECODER_STREAM_UNLOCK (self);
+  return ok;
+}
+
+static gboolean
+gst_hevc_runner_allocation_plan (GstV4l2CodecH265Dec * self,
+    guint32 frame, gboolean * active, gboolean * selected, guint * remaining)
+{
+  gboolean ok = TRUE;
+
+  *active = FALSE;
+  *selected = FALSE;
+  *remaining = 0;
+  GST_VIDEO_DECODER_STREAM_LOCK (self);
+  GstHevcRunner *runner = self->content_runner;
+  if (!runner)
+    goto done;
+  if (runner->terminal) {
+    ok = g_atomic_int_get (&runner->status) == GST_HEVC_RUNNER_SUCCESS;
+    goto done;
+  }
+  if (!runner->allocation_frozen || !runner->armed) {
+    ok = FALSE;
+    goto done;
+  }
+  *active = TRUE;
+  *remaining = runner->remaining_allocations;
+  for (guint i = 0; i < runner->count; i++) {
+    if (runner->frames[i] != frame)
+      continue;
+    if ((runner->allocated_mask & (1u << i)) || !runner->remaining_allocations) {
+      ok = FALSE;
+      goto done;
+    }
+    *selected = TRUE;
+    break;
+  }
+done:
+  GST_VIDEO_DECODER_STREAM_UNLOCK (self);
+  return ok;
+}
+
+static gboolean
+gst_hevc_runner_allocation_commit (GstV4l2CodecH265Dec * self, guint32 frame)
+{
+  gboolean ok = FALSE;
+
+  GST_VIDEO_DECODER_STREAM_LOCK (self);
+  GstHevcRunner *runner = self->content_runner;
+  if (!runner || !runner->allocation_frozen || !runner->armed ||
+      runner->terminal || !runner->remaining_allocations)
+    goto done;
+  for (guint i = 0; i < runner->count; i++) {
+    if (runner->frames[i] != frame)
+      continue;
+    if (runner->allocated_mask & (1u << i))
+      goto done;
+    runner->allocated_mask |= 1u << i;
+    runner->remaining_allocations--;
+    ok = TRUE;
+    break;
+  }
+done:
+  GST_VIDEO_DECODER_STREAM_UNLOCK (self);
+  return ok;
+}

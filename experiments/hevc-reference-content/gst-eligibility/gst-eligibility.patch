+static GList *
+gst_v4l2_codec_allocator_observer_candidate (GstV4l2CodecAllocator * self,
+    gboolean selected, guint remaining_selected)
+{
+  GList *first_unpublished = NULL;
+  guint unpublished = 0;
+
+  for (GList *item = self->pool.head; item; item = item->next) {
+    GstV4l2CodecBuffer *buf = item->data;
+    if (buf->observer_published) {
+      if (!selected)
+        return item;
+    } else {
+      if (!first_unpublished)
+        first_unpublished = item;
+      unpublished++;
+    }
+  }
+
+  if (selected || unpublished > remaining_selected)
+    return first_unpublished;
+  return NULL;
+}
+
+gboolean
+gst_v4l2_codec_allocator_prepare_observer_buffer (
+    GstV4l2CodecAllocator * self, GstBuffer * gstbuf, gboolean selected,
+    guint remaining_selected)
+{
+  GST_HEVC_OBSERVER_LOCK;
+  if (gst_hevc_observer_busy (self->decoder))
+    return FALSE;
+  GstV4l2CodecBuffer *buf;
+  GList *candidate;
+
+  GST_OBJECT_LOCK (self);
+  candidate = gst_v4l2_codec_allocator_observer_candidate (self, selected,
+      remaining_selected);
+  if (!candidate) {
+    GST_OBJECT_UNLOCK (self);
+    return FALSE;
+  }
+  buf = candidate->data;
+  g_queue_delete_link (&self->pool, candidate);
+  GST_DEBUG_OBJECT (self, "Observer allocated %s buffer %i",
+      selected ? "selected unpublished" :
+      buf->observer_published ? "published" : "surplus unpublished",
+      buf->index);
+  gst_v4l2_codec_buffer_acquire (buf);
+  for (guint i = 0; i < buf->num_mems; i++) {
+    gst_buffer_append_memory (gstbuf, buf->mem[i]);
+    g_object_ref (buf->mem[i]->allocator);
+  }
+  GST_OBJECT_UNLOCK (self);
+  return TRUE;
+}
+
+gboolean
+gst_v4l2_codec_allocator_wait_for_observer_buffer (
+    GstV4l2CodecAllocator * self, guint remaining_selected)
+{
+  gboolean ret;
+
+  GST_OBJECT_LOCK (self);
+  while (!g_atomic_int_get (&self->flushing) &&
+      !gst_v4l2_codec_allocator_observer_candidate (self, FALSE,
+          remaining_selected))
+    g_cond_wait (&self->buffer_cond, GST_OBJECT_GET_LOCK (self));
+  ret = !g_atomic_int_get (&self->flushing);
+  GST_OBJECT_UNLOCK (self);
+  return ret;
+}

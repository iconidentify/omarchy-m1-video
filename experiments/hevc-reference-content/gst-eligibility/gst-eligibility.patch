+GstFlowReturn
+gst_v4l2_codec_pool_acquire_observer_buffer (GstV4l2CodecPool * self,
+    GstBuffer ** buffer, gboolean selected, guint remaining_selected)
+{
+  GstBuffer *buf;
+  GstVideoMeta *vmeta;
+
+  g_return_val_if_fail (self->vinfo_drm, GST_FLOW_ERROR);
+  g_return_val_if_fail (remaining_selected > 0 || !selected, GST_FLOW_ERROR);
+
+  buf = gst_atomic_queue_pop (self->queue);
+  if (!buf)
+    buf = gst_v4l2_codec_pool_create_empty_buffer ();
+
+  if (!gst_v4l2_codec_allocator_prepare_observer_buffer (self->allocator,
+          buf, selected, remaining_selected)) {
+    GstFlowReturn flow_ret = GST_FLOW_EOS;
+
+    /* A selected output cannot wait: an outstanding allocation becomes
+     * published before it returns.  Ordinary output may wait for a published
+     * allocation without consuming the finite unpublished reserve. */
+    if (!selected && gst_v4l2_codec_allocator_wait_for_observer_buffer (
+            self->allocator, remaining_selected)) {
+      if (gst_v4l2_codec_allocator_prepare_observer_buffer (self->allocator,
+              buf, FALSE, remaining_selected))
+        flow_ret = GST_FLOW_OK;
+    } else if (!selected) {
+      flow_ret = GST_FLOW_FLUSHING;
+    }
+    if (flow_ret != GST_FLOW_OK) {
+      gst_atomic_queue_push (self->queue, buf);
+      return flow_ret;
+    }
+  }
+
+  vmeta = gst_buffer_get_video_meta (buf);
+  vmeta->format = GST_VIDEO_INFO_FORMAT (&self->vinfo_drm->vinfo);
+  vmeta->width = GST_VIDEO_INFO_WIDTH (&self->vinfo_drm->vinfo);
+  vmeta->height = GST_VIDEO_INFO_HEIGHT (&self->vinfo_drm->vinfo);
+  vmeta->n_planes = gst_v4l2_format_get_n_planes (self->vinfo_drm);
+  memcpy (vmeta->offset, self->vinfo_drm->vinfo.offset,
+      sizeof (vmeta->offset));
+  memcpy (vmeta->stride, self->vinfo_drm->vinfo.stride,
+      sizeof (vmeta->stride));
+  *buffer = buf;
+  return GST_FLOW_OK;
+}

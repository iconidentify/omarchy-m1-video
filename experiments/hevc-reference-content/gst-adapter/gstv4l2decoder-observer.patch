+/* SPDX-License-Identifier: LGPL-2.1-or-later */
+#pragma once
+#include "gstv4l2decoder.h"
+
+typedef struct {
+  guint64 run[2], context, nonce;
+} GstHevcObserverSession;
+typedef struct {
+  guint64 request, allocation, writer;
+} GstHevcObserverTarget;
+typedef struct {
+  GstHevcObserverSession session;
+  GstHevcObserverTarget target;
+  guint64 lease, submitted, completed;
+  guint32 frame_num, capture_index, planes;
+  guint64 plane_size[GST_VIDEO_MAX_PLANES];
+} GstHevcObserverReceipt;
+
+/* Experimental internal plugin API, metadata only. Inputs must be live owned
+ * decoder/request references. No raw mapping/FD/coherence or copy capability. */
+gboolean gst_hevc_observer_open (GstV4l2Decoder *self, GstHevcObserverSession *session);
+gboolean gst_hevc_observer_select (GstV4l2Decoder *self, const GstHevcObserverSession *session,
+    GstV4l2Request *request, GstHevcObserverTarget *target);
+/* Absolute monotonic nanoseconds, 0 = now + 2 seconds; maximum 2 seconds.
+ * Successful begin defers pthread cancellation until the matching owner end. */
+gboolean gst_hevc_observer_begin (GstV4l2Decoder *self, const GstHevcObserverSession *session,
+    GstV4l2Request *request, const GstHevcObserverTarget *target, guint64 deadline,
+    GstHevcObserverReceipt *receipt);
+gboolean gst_hevc_observer_end (GstV4l2Decoder *self, const GstHevcObserverSession *session,
+    guint64 lease);
+gboolean gst_hevc_observer_close (GstV4l2Decoder *self, const GstHevcObserverSession *session);

+/* Experimental metadata observer: keep the actual request/context definitions
+ * and lifecycle in this translation unit. No borrowed-pointer registry. */
+GRecMutex gst_hevc_observer_mutex;
+
+guint64
+gst_hevc_observer_generation (void)
+{
+  GST_HEVC_OBSERVER_LOCK;
+  static guint64 next = 1;
+  guint64 value = next;
+  if (next) next++;
+  return value; /* exhaustion stays zero; never reuse an identity */
+}
+
+guint64
+gst_hevc_observer_now (void)
+{
+  struct timespec ts;
+  clock_gettime (CLOCK_MONOTONIC, &ts);
+  return (guint64) ts.tv_sec * GST_SECOND + ts.tv_nsec;
+}
+
+gboolean
+gst_hevc_observer_busy (GstV4l2Decoder *self)
+{
+  GST_HEVC_OBSERVER_LOCK;
+  return self && (self->observer_lease || self->observer_ending);
+}
+
+gboolean
+gst_hevc_observer_retained (GstV4l2Decoder *self)
+{
+  GST_HEVC_OBSERVER_LOCK;
+  return self && self->observer_lease;
+}
+
+static gboolean
+observer_lock_until (guint64 deadline)
+{
+  while (gst_hevc_observer_now () < deadline) {
+    if (g_rec_mutex_trylock (&gst_hevc_observer_mutex))
+      return TRUE;
+    g_usleep (100);
+  }
+  return FALSE;
+}
+
+static gboolean
+observer_session_valid (GstV4l2Decoder *self, const GstHevcObserverSession *session)
+{
+  return self && session && session->nonce && session->nonce == self->observer_session &&
+      session->context == self->observer_generation &&
+      !memcmp (session->run, self->observer_run, sizeof (session->run)) &&
+      self->observer_owner == g_thread_self ();
+}
+
+static void
+observer_session_record (GstV4l2Decoder *self, GstHevcObserverSession *session)
+{
+  *session = (GstHevcObserverSession) {
+    .run = {self->observer_run[0], self->observer_run[1]},
+    .context = self->observer_generation, .nonce = self->observer_session,
+  };
+}
+
+static gboolean
+observer_selection (GstV4l2Decoder *self, GstV4l2Request *request,
+    GstHevcObserverReceipt *receipt)
+{
+  if (!request || request->decoder != self || !request->observer_generation ||
+      !request->observer_submitted || !request->observer_writer || request->failed ||
+      request->sub_request || request->hold_pic_buf || !request->pic_buf)
+    return FALSE;
+  if (!gst_hevc_observer_buffer_identity (request->pic_buf, self, receipt) ||
+      receipt->target.writer != request->observer_writer)
+    return FALSE;
+  receipt->target.request = request->observer_generation;
+  receipt->frame_num = request->frame_num;
+  return TRUE;
+}
+
+gboolean
+gst_hevc_observer_open (GstV4l2Decoder *self, GstHevcObserverSession *session)
+{
+  if (!self || !session) return FALSE;
+  gint cancel;
+  pthread_setcancelstate (PTHREAD_CANCEL_DISABLE, &cancel);
+  gboolean ok = FALSE;
+  if (observer_lock_until (gst_hevc_observer_now () + 2 * GST_SECOND)) {
+    if (self->opened && !self->doc_mode && !self->observer_retired &&
+        self->observer_format == V4L2_PIX_FMT_HEVC_SLICE &&
+        self->observer_generation && (self->observer_run[0] || self->observer_run[1]) &&
+        !self->observer_session && !gst_hevc_observer_busy (self)) {
+      self->observer_session = gst_hevc_observer_generation ();
+      if (self->observer_session) {
+        self->observer_owner = g_thread_ref (g_thread_self ());
+        observer_session_record (self, session);
+        ok = TRUE;
+      }
+    }
+    g_rec_mutex_unlock (&gst_hevc_observer_mutex);
+  }
+  pthread_setcancelstate (cancel, NULL);
+  return ok;
+}
+
+gboolean
+gst_hevc_observer_select (GstV4l2Decoder *self, const GstHevcObserverSession *session,
+    GstV4l2Request *request, GstHevcObserverTarget *target)
+{
+  if (!self || !target) return FALSE;
+  gint cancel;
+  pthread_setcancelstate (PTHREAD_CANCEL_DISABLE, &cancel);
+  gboolean ok = FALSE;
+  if (observer_lock_until (gst_hevc_observer_now () + 2 * GST_SECOND)) {
+    GstHevcObserverReceipt current = {0};
+    if (observer_session_valid (self, session) && !gst_hevc_observer_busy (self) &&
+        observer_selection (self, request, &current)) {
+      *target = current.target;
+      ok = TRUE;
+    }
+    g_rec_mutex_unlock (&gst_hevc_observer_mutex);
+  }
+  pthread_setcancelstate (cancel, NULL);
+  return ok;
+}
+
+gboolean
+gst_hevc_observer_begin (GstV4l2Decoder *self, const GstHevcObserverSession *session,
+    GstV4l2Request *request, const GstHevcObserverTarget *target, guint64 deadline,
+    GstHevcObserverReceipt *receipt)
+{
+  if (!self || !target || !receipt) return FALSE;
+  guint64 now = gst_hevc_observer_now ();
+  if (!deadline) deadline = now + 2 * GST_SECOND;
+  if (deadline <= now || deadline - now > 2 * GST_SECOND) return FALSE;
+  gint cancel;
+  pthread_setcancelstate (PTHREAD_CANCEL_DISABLE, &cancel);
+  gboolean ok = FALSE;
+  if (!observer_lock_until (deadline)) goto restore;
+  GstHevcObserverReceipt current = {0};
+  if (!observer_session_valid (self, session) || gst_hevc_observer_busy (self) ||
+      !self->opened || !self->observer_streaming[0] || !self->observer_streaming[1] ||
+      self->observer_retired || self->observer_failed ||
+      self->observer_format != V4L2_PIX_FMT_HEVC_SLICE ||
+      self->observer_partial || self->observer_external || self->observer_unqueued ||
+      !observer_selection (self, request, &current) ||
+      current.target.request != target->request || current.target.allocation != target->allocation ||
+      current.target.writer != target->writer)
+    goto unlock;
+  /* Own the actual request, picture buffer, allocator memory and decoder before
+   * completion can retire the pending queue's references. */
+  GstV4l2Request *held = gst_v4l2_request_ref (request);
+  GstBuffer *picture = gst_buffer_ref (request->pic_buf);
+  GstMemory *bits = request->bitstream ? gst_memory_ref (request->bitstream) : NULL;
+  self->observer_deadline = deadline;
+  while (gst_vec_deque_get_length (self->pending_requests)) {
+    GstV4l2Request *pending = gst_v4l2_request_ref (
+        gst_vec_deque_peek_head (self->pending_requests));
+    gboolean done = !pending->hold_pic_buf && !pending->sub_request &&
+        gst_hevc_observer_now () < deadline &&
+        gst_v4l2_request_set_done (pending) > 0 && !pending->pending && !pending->failed;
+    gst_v4l2_request_unref (pending);
+    if (!done) {
+      self->observer_failed = TRUE;
+      break;
+    }
+  }
+  self->observer_deadline = 0;
+  if (self->observer_failed || self->observer_completed != self->observer_submitted ||
+      request->observer_completed != target->writer ||
+      !observer_selection (self, request, &current) || gst_hevc_observer_now () >= deadline)
+    goto release;
+  guint64 lease = gst_hevc_observer_generation ();
+  if (!lease) goto release;
+  self->observer_lease = lease;
+  self->observer_request = held;
+  self->observer_picture = picture;
+  self->observer_bitstream = bits;
+  self->observer_cancel_state = cancel;
+  g_object_ref (self);
+  observer_session_record (self, &current.session);
+  current.lease = lease;
+  current.submitted = self->observer_submitted;
+  current.completed = self->observer_completed;
+  *receipt = current;
+  ok = TRUE;
+  goto unlock;
+release:
+  gst_v4l2_request_unref (held);
+  gst_buffer_unref (picture);
+  if (bits) gst_memory_unref (bits);
+unlock:
+  g_rec_mutex_unlock (&gst_hevc_observer_mutex);
+restore:
+  if (!ok) pthread_setcancelstate (cancel, NULL);
+  return ok;
+}
+
+gboolean
+gst_hevc_observer_end (GstV4l2Decoder *self, const GstHevcObserverSession *session,
+    guint64 lease)
+{
+  if (!self) return FALSE;
+  gint cancel;
+  pthread_setcancelstate (PTHREAD_CANCEL_DISABLE, &cancel);
+  gboolean ok = FALSE;
+  if (observer_lock_until (gst_hevc_observer_now () + 2 * GST_SECOND)) {
+    if (observer_session_valid (self, session) && lease &&
+        self->observer_lease == lease && !self->observer_ending) {
+      self->observer_ending = TRUE;
+      self->observer_lease = 0;
+      g_clear_pointer (&self->observer_request, gst_v4l2_request_unref);
+      g_clear_pointer (&self->observer_picture, gst_buffer_unref);
+      g_clear_pointer (&self->observer_bitstream, gst_memory_unref);
+      self->observer_ending = FALSE;
+      cancel = self->observer_cancel_state;
+      ok = TRUE;
+      g_object_unref (self); /* last: may run real decoder finalization */
+    }
+    g_rec_mutex_unlock (&gst_hevc_observer_mutex);
+  }
+  pthread_setcancelstate (cancel, NULL);
+  return ok;
+}
+
+gboolean
+gst_hevc_observer_close (GstV4l2Decoder *self, const GstHevcObserverSession *session)
+{
+  if (!self) return FALSE;
+  gint cancel;
+  pthread_setcancelstate (PTHREAD_CANCEL_DISABLE, &cancel);
+  gboolean ok = FALSE;
+  if (observer_lock_until (gst_hevc_observer_now () + 2 * GST_SECOND)) {
+    if (observer_session_valid (self, session) && !gst_hevc_observer_busy (self)) {
+      self->observer_session = 0;
+      g_clear_pointer (&self->observer_owner, g_thread_unref);
+      ok = TRUE;
+    }
+    g_rec_mutex_unlock (&gst_hevc_observer_mutex);
+  }
+  pthread_setcancelstate (cancel, NULL);
+  return ok;
+}
+
+static void
+gst_hevc_observer_trace (GstV4l2Request *request)
+{
+  GstV4l2Decoder *self = request->decoder;
+  GstHevcObserverReceipt receipt = {0};
+  if (self->observer_session && observer_selection (self, request, &receipt))
+    GST_TRACE_OBJECT (self, "observer-queue run=%016" G_GINT64_MODIFIER "x%016"
+        G_GINT64_MODIFIER "x context=%" G_GUINT64_FORMAT " allocation=%"
+        G_GUINT64_FORMAT " request=%" G_GUINT64_FORMAT " writer=%"
+        G_GUINT64_FORMAT " frame=%u capture=%u", self->observer_run[0],
+        self->observer_run[1], self->observer_generation, receipt.target.allocation,
+        receipt.target.request, receipt.target.writer, request->frame_num, receipt.capture_index);
+}
+
+gboolean
+gst_v4l2_decoder_export_buffer (GstV4l2Decoder *self, GstPadDirection direction,
+    gint index, gint *fds, gsize *sizes, gsize *offsets, guint *num_fds)
+{
+  GST_HEVC_OBSERVER_LOCK;
+  if (gst_hevc_observer_busy (self)) return FALSE;
+  self->observer_external = TRUE;
+  return gst_hevc_observer_export_buffer (self, direction, index, fds, sizes, offsets, num_fds);
+}

 }
+
+/* Read identity from the actual allocator-owned object behind all planes. */
+static GstV4l2CodecBuffer *
+observer_buffer (GstBuffer *buffer, GstV4l2Decoder *decoder)
+{
+  if (!buffer || !gst_buffer_n_memory (buffer)) return NULL;
+  GstMemory *mem = gst_buffer_peek_memory (buffer, 0);
+  if (!GST_V4L2_CODEC_IS_ALLOCATOR (mem->allocator)) return NULL;
+  GstV4l2CodecAllocator *allocator = GST_V4L2_CODEC_ALLOCATOR (mem->allocator);
+  if (allocator->decoder != decoder || allocator->direction != GST_PAD_SRC || allocator->detached)
+    return NULL;
+  GstV4l2CodecBuffer *buf = gst_mini_object_get_qdata (GST_MINI_OBJECT (mem),
+      gst_v4l2_codec_buffer_quark ());
+  if (!buf || buf->num_mems != gst_buffer_n_memory (buffer) ||
+      buf->num_mems > GST_VIDEO_MAX_PLANES || !buf->observer_generation)
+    return NULL;
+  for (guint i = 0; i < buf->num_mems; i++)
+    if (buf->mem[i] != gst_buffer_peek_memory (buffer, i)) return NULL;
+  return buf;
+}
+
+gboolean
+gst_hevc_observer_buffer_identity (GstBuffer *buffer, GstV4l2Decoder *decoder,
+    GstHevcObserverReceipt *receipt)
+{
+  GST_HEVC_OBSERVER_LOCK;
+  GstV4l2CodecBuffer *buf = observer_buffer (buffer, decoder);
+  if (!buf || buf->observer_published || !buf->observer_writer) return FALSE;
+  receipt->target.allocation = buf->observer_generation;
+  receipt->target.writer = buf->observer_writer;
+  receipt->capture_index = buf->index;
+  receipt->planes = buf->num_mems;
+  for (guint i = 0; i < buf->num_mems; i++)
+    receipt->plane_size[i] = buf->mem[i]->maxsize;
+  return TRUE;
+}
+
+void
+gst_hevc_observer_buffer_writer (GstBuffer *buffer, GstV4l2Decoder *decoder,
+    guint64 writer, gboolean completed)
+{
+  GST_HEVC_OBSERVER_LOCK;
+  GstV4l2CodecBuffer *buf = observer_buffer (buffer, decoder);
+  if (!buf) return;
+  if (completed) {
+    if (buf->observer_writer == writer) buf->observer_completed = writer;
+  } else {
+    buf->observer_writer = writer;
+    buf->observer_completed = 0;
+  }
+}
+
+void
+gst_hevc_observer_buffer_publish (GstBuffer *buffer)
+{
+  GST_HEVC_OBSERVER_LOCK;
+  if (!buffer) return;
+  for (guint i = 0; i < gst_buffer_n_memory (buffer); i++) {
+    GstMemory *mem = gst_buffer_peek_memory (buffer, i);
+    GstV4l2CodecBuffer *buf = gst_mini_object_get_qdata (GST_MINI_OBJECT (mem),
+        gst_v4l2_codec_buffer_quark ());
+    if (buf) buf->observer_published = TRUE;
+  }
+}
+
+static gboolean
+observer_map_admit (GstV4l2CodecAllocator *self, GstMemory *mem)
+{
+  if (self->direction != GST_PAD_SRC) return TRUE;
+  if (gst_hevc_observer_busy (self->decoder)) return FALSE;
+  while (mem->parent) mem = mem->parent;
+  GstV4l2CodecBuffer *buf = gst_mini_object_get_qdata (GST_MINI_OBJECT (mem),
+      gst_v4l2_codec_buffer_quark ());
+  if (buf) buf->observer_published = TRUE;
+  return TRUE;
+}
+
+static gpointer
+observer_memory_map (GstMemory *mem, gsize maxsize, GstMapFlags flags)
+{
+  GST_HEVC_OBSERVER_LOCK;
+  GstV4l2CodecAllocator *self = GST_V4L2_CODEC_ALLOCATOR (mem->allocator);
+  if (!observer_map_admit (self, mem)) return NULL;
+  return self->observer_map (mem, maxsize, flags);
+}
+
+static gpointer
+observer_memory_map_full (GstMemory *mem, GstMapInfo *info, gsize maxsize)
+{
+  GST_HEVC_OBSERVER_LOCK;
+  GstV4l2CodecAllocator *self = GST_V4L2_CODEC_ALLOCATOR (mem->allocator);
+  if (!observer_map_admit (self, mem)) return NULL;
+  return self->observer_map_full (mem, info, maxsize);
+}
+
+gboolean
+gst_hevc_observer_buffer_owned (GstBuffer *buffer, GstV4l2Decoder *decoder)
+{
+  GST_HEVC_OBSERVER_LOCK;
+  return observer_buffer (buffer, decoder) != NULL;
+}
+
+static GstMemory *
+observer_memory_share (GstMemory *mem, gssize offset, gssize size)
+{
+  GST_HEVC_OBSERVER_LOCK;
+  GstV4l2CodecAllocator *self = GST_V4L2_CODEC_ALLOCATOR (mem->allocator);
+  if (!observer_map_admit (self, mem)) return NULL;
+  return self->observer_share (mem, offset, size);
+}

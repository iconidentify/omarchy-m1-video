 }
 
+static int vaapi_observer_readback_option(AVHWDeviceContext *ctx, AVDictionary *opts)
+{
+    VAAPIDeviceContext *hwctx = ctx->hwctx;
+    const AVDictionaryEntry *entry = av_dict_get(opts, "observer_copy_readback", NULL, 0);
+
+    if (!entry)
+        return 0;
+    if (strcmp(entry->value, "0") && strcmp(entry->value, "1")) {
+        av_log(ctx, AV_LOG_ERROR, "observer_copy_readback must be 0 or 1.\n");
+        return AVERROR(EINVAL);
+    }
+    hwctx->observer_copy_readback = !strcmp(entry->value, "1");
+    return 0;
+}
+
 static int vaapi_device_create(AVHWDeviceContext *ctx, const char *device,
                                AVDictionary *opts, int flags)
 {

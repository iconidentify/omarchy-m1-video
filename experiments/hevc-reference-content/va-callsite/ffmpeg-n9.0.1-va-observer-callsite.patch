+typedef VAStatus (*VAObserverBegin)(VADriverContextP,
+                                    const struct VAObserverSession *,
+                                    const struct VAObserverTarget *, uint64_t,
+                                    struct VAObserverReceipt *);
+typedef VAStatus (*VAObserverEnd)(VADriverContextP,
+                                  const struct VAObserverSession *, uint64_t);
+typedef VAStatus (*VAObserverClose)(VADriverContextP,
+                                    const struct VAObserverSession *);
+typedef uint64_t (*VAObserverABI)(void);
+typedef void (*VAContentInit)(struct VAContentPool *, bool);
+typedef bool (*VAContentSnapshot)(VADriverContextP,
+                                  const struct VAObserverReceipt *,
+                                  struct VAContentPool *, bool);
+
+typedef struct VAAPIObserverState {
+    void *driver_handle;
+    VADriverContextP driver;
+    VAObserverOpen open;
+    VAObserverSelect select;
+    VAObserverBegin begin;
+    VAObserverEnd end;
+    VAObserverClose close;
+    VAObserverABI abi;
+    VAContentInit content_init;
+    VAContentSnapshot content_snapshot;
+    struct VAObserverSession session;
+    struct VAObserverReceipt receipt;
+    struct VAContentPool *pool;
+    VAAPIObserverResult result;
+    AVFrame *held_frame;
+    uint64_t outputs[VA_OBSERVER_SLOTS];
+    unsigned nb_outputs;
+    unsigned seen;
+    uint64_t output_index;
+    pthread_t owner;
+    bool copy;
+    bool active;
+    bool closed;
+    bool failed;
+    bool finished;
+} VAAPIObserverState;
+
+static int vaapi_observer_symbol(VAAPIObserverState *state,
+                                 const Dl_info *origin, const char *name,
+                                 void *result, size_t result_size)
+{
+    void *symbol;
+    Dl_info info;
+
+    if (result_size != sizeof(symbol))
+        return AVERROR(ENOSYS);
+    dlerror();
+    symbol = dlsym(state->driver_handle, name);
+    if (!symbol || dlerror() || !dladdr(symbol, &info) ||
+        info.dli_fbase != origin->dli_fbase)
+        return AVERROR(ENOSYS);
+    memcpy(result, &symbol, sizeof(symbol));
+    return 0;
+}
+
+static int vaapi_observer_bind(VAAPIDecodeContext *ctx,
+                               VAAPIObserverState *state)
+{
+#if !defined(__linux__) || !defined(RTLD_NOLOAD)
+    return AVERROR(ENOSYS);
+#else
+    VADisplayContextP display = (VADisplayContextP)ctx->hwctx->display;
+    VADriverContextP driver;
+    void *origin_symbol = NULL;
+    Dl_info origin;
+    int err;
+
+    if (!display || !vaDisplayIsValid(ctx->hwctx->display) ||
+        display->vadpy_magic != VA_DISPLAY_MAGIC ||
+        !(driver = display->pDriverContext) || !driver->vtable ||
+        !driver->vtable->vaEndPicture)
+        return AVERROR(ENODEV);
+
+    if (sizeof(origin_symbol) != sizeof(driver->vtable->vaEndPicture))
+        return AVERROR(ENOSYS);
+    memcpy(&origin_symbol, &driver->vtable->vaEndPicture,
+           sizeof(origin_symbol));
+    if (!origin_symbol || !dladdr(origin_symbol, &origin) ||
+        !origin.dli_fname || !origin.dli_fbase)
+        return AVERROR(ENODEV);
+
+    state->driver_handle = dlopen(origin.dli_fname,
+                                  RTLD_NOW | RTLD_LOCAL | RTLD_NOLOAD);
+    if (!state->driver_handle)
+        return AVERROR(ENODEV);
+    state->driver = driver;
+
+#define LOAD(member, symbol_name) do {                                      \
+        err = vaapi_observer_symbol(state, &origin, symbol_name,             \
+                                    &state->member, sizeof(state->member));   \
+        if (err < 0)                                                         \
+            return err;                                                      \
+    } while (0)
+    LOAD(open,             "v4l2r_observer_open");
+    LOAD(select,           "v4l2r_observer_select");
+    LOAD(begin,            "v4l2r_observer_begin");
+    LOAD(end,              "v4l2r_observer_end");
+    LOAD(close,            "v4l2r_observer_close");
+    LOAD(abi,              "v4l2r_observer_client_abi");
+    LOAD(content_init,     "v4l2r_content_init");
+    LOAD(content_snapshot, "v4l2r_content_snapshot");
+#undef LOAD
+    if (state->abi() != VA_OBSERVER_ABI)
+        return AVERROR(ENOSYS);
+    return 0;
+#endif
+}
+
+static int vaapi_observer_parse_outputs(const char *value,
+                                        uint64_t outputs[VA_OBSERVER_SLOTS],
+                                        unsigned *count)
+{
+    const char *p = value;
+    unsigned n = 0;
+
+    if (!p || !*p)
+        return AVERROR(EINVAL);
+    for (;;) {
+        char *end;
+        unsigned long long output;
+
+        if (n == VA_OBSERVER_SLOTS || *p == '+' || *p == '-')
+            return AVERROR(EINVAL);
+        errno = 0;
+        output = strtoull(p, &end, 10);
+        if (errno || end == p)
+            return AVERROR(EINVAL);
+        for (unsigned i = 0; i < n; i++)
+            if (outputs[i] == output)
+                return AVERROR(EINVAL);
+        outputs[n++] = output;
+        if (!*end)
+            break;
+        if (*end != ',' || !end[1])
+            return AVERROR(EINVAL);
+        p = end + 1;
+    }
+    *count = n;
+    return 0;
+}
+
+static void vaapi_observer_free(VAAPIObserverState **statep)
+{
+    VAAPIObserverState *state = *statep;
+    if (!state)
+        return;
+    av_frame_free(&state->held_frame);
+    av_freep(&state->pool);
+    if (state->driver_handle)
+        dlclose(state->driver_handle);
+    av_freep(statep);
+}
+
+int ff_vaapi_decode_observer_arm(AVCodecContext *avctx,
+                                 const char *outputs, int copy)
+{
+    VAAPIDecodeContext *ctx;
+    VAAPIObserverState *state;
+    int err;
+
+    if (!outputs)
+        return 0;
+    if (!avctx || !avctx->internal)
+        return AVERROR(EINVAL);
+    ctx = avctx->internal->hwaccel_priv_data;
+    if (!ctx || ctx->observer)
+        return ctx && ctx->observer ? 0 : AVERROR(EINVAL);
+    if (avctx->codec_id != AV_CODEC_ID_HEVC || avctx->pix_fmt != AV_PIX_FMT_VAAPI ||
+        ctx->va_context == VA_INVALID_ID || ctx->observer_issued)
+        return AVERROR(EINVAL);
+    if (avctx->active_thread_type || avctx->thread_count != 1) {
+        av_log(avctx, AV_LOG_ERROR,
+               "VA reference-content observer requires single-threaded "
+               "decoding (set threads=1).\n");
+        return AVERROR(ENOSYS);
+    }
+
+    state = av_mallocz(sizeof(*state));
+    if (!state)
+        return AVERROR(ENOMEM);
+    state->pool = av_mallocz(sizeof(*state->pool));
+    state->held_frame = av_frame_alloc();
+    if (!state->pool || !state->held_frame) {
+        err = AVERROR(ENOMEM);
+        goto fail;
+    }
+    err = vaapi_observer_parse_outputs(outputs, state->outputs,
+                                       &state->nb_outputs);
+    if (err < 0)
+        goto fail;
+    err = vaapi_observer_bind(ctx, state);
+    if (err < 0)
+        goto fail;
+    state->copy = !!copy;
+    state->owner = pthread_self();
+    state->content_init(state->pool, true);
+    if (state->open(state->driver, ctx->va_context, &state->session) !=
+        VA_STATUS_SUCCESS) {
+        err = AVERROR(EIO);
+        goto fail;
+    }
+    ctx->observer = state;
+    return 0;
+
+fail:
+    vaapi_observer_free(&state);
+    return err;
+}
+
+static int vaapi_observer_selected(VAAPIObserverState *state, uint64_t output)
+{
+    for (unsigned i = 0; i < state->nb_outputs; i++)
+        if (state->outputs[i] == output)
+            return i;
+    return -1;
+}
+
+int ff_vaapi_decode_observer_output(AVCodecContext *avctx, AVFrame *frame)
+{
+    VAAPIDecodeContext *ctx;
+    VAAPIObserverState *state;
+    struct VAObserverTarget target;
+    VASurfaceID surface;
+    VAStatus end_status;
+    struct AVSHA *sha = NULL;
+    bool copied;
+    int selected, err;
+
+    if (!avctx || !avctx->internal || !avctx->internal->hwaccel_priv_data ||
+        avctx->pix_fmt != AV_PIX_FMT_VAAPI)
+        return 0;
+    ctx = avctx->internal->hwaccel_priv_data;
+    state = ctx->observer;
+    if (!state)
+        return 0;
+    if (!pthread_equal(state->owner, pthread_self()) || state->closed ||
+        state->failed || state->active || !frame || frame->format != AV_PIX_FMT_VAAPI) {
+        state->failed = true;
+        return AVERROR(EINVAL);
+    }
+
+    selected = vaapi_observer_selected(state, state->output_index++);
+    if (selected < 0)
+        return 0;
+    if (state->seen & (1U << selected)) {
+        state->failed = true;
+        return AVERROR(EINVAL);
+    }
+    surface = ff_vaapi_get_surface_id(frame);
+    if (surface == VA_INVALID_SURFACE || av_frame_ref(state->held_frame, frame) < 0) {
+        state->failed = true;
+        return AVERROR(ENOMEM);
+    }
+    if (state->select(state->driver, &state->session, surface, &target) !=
+        VA_STATUS_SUCCESS || target.surface != surface) {
+        err = AVERROR(EIO);
+        goto fail_without_lease;
+    }
+    memset(&state->receipt, 0, sizeof(state->receipt));
+    if (state->begin(state->driver, &state->session, &target, 0,
+                     &state->receipt) != VA_STATUS_SUCCESS) {
+        err = AVERROR(EIO);
+        goto fail_without_lease;
+    }
+    state->active = true;
+    if (state->receipt.target.surface != surface) {
+        state->failed = true;
+        end_status = state->end(state->driver, &state->session,
+                                state->receipt.lease);
+        if (end_status != VA_STATUS_SUCCESS)
+            return AVERROR(EIO);
+        state->active = false;
+        av_frame_unref(state->held_frame);
+        return AVERROR(EIO);
+    }
+    copied = state->content_snapshot(state->driver, &state->receipt,
+                                     state->pool, state->copy);
+    end_status = state->end(state->driver, &state->session,
+                            state->receipt.lease);
+    if (end_status != VA_STATUS_SUCCESS) {
+        state->failed = true;
+        return AVERROR(EIO);
+    }
+    state->active = false;
+    av_frame_unref(state->held_frame);
+    if (!copied || !state->pool->used ||
+        !state->pool->slot[state->pool->used - 1].valid) {
+        state->failed = true;
+        return AVERROR(EIO);
+    }
+    if (state->result.count >= VAAPI_OBSERVER_MAX_OUTPUTS) {
+        state->failed = true;
+        return AVERROR(EOVERFLOW);
+    }
+    const unsigned pool_index = state->pool->used - 1;
+    const struct VAContentIdentity *identity =
+        &state->pool->slot[pool_index].identity;
+    if (identity->client != VA_CONTENT_CLIENT_VA ||
+        identity->detail.va.surface != surface) {
+        state->failed = true;
+        return AVERROR(EIO);
+    }
+    VAAPIObserverResultSlot *result = &state->result.slot[state->result.count];
+    *result = (VAAPIObserverResultSlot) {
+        .output_index = state->output_index - 1,
+        .surface = surface,
+        .run = {identity->run[0], identity->run[1]},
+        .context_generation = identity->context_generation,
+        .session = identity->session,
+        .allocation_generation = identity->allocation_generation,
+        .writer = identity->writer,
+        .submitted = identity->submitted,
+        .completed = identity->completed,
+        .capture_index = identity->capture_index,
+        .copied = state->pool->slot[pool_index].copied,
+    };
+    if (result->copied) {
+        sha = av_sha_alloc();
+        if (!sha || av_sha_init(sha, 256) < 0) {
+            av_free(sha);
+            state->failed = true;
+            return AVERROR(ENOMEM);
+        }
+        av_sha_update(sha, state->pool->slot[pool_index].bytes,
+                      VA_OBSERVER_BYTES);
+        av_sha_final(sha, result->sha256);
+        av_free(sha);
+    }
+    state->result.count++;
+    state->seen |= 1U << selected;
+    return 0;
+
+fail_without_lease:
+    av_frame_unref(state->held_frame);
+    state->failed = true;
+    return err;
+}
+
+int ff_vaapi_decode_observer_finish(AVCodecContext *avctx)
+{
+    VAAPIDecodeContext *ctx;
+    VAAPIObserverState *state;
+    int err = 0;
+
+    if (!avctx || !avctx->internal || !avctx->internal->hwaccel_priv_data)
+        return 0;
+    ctx = avctx->internal->hwaccel_priv_data;
+    state = ctx->observer;
+    if (!state)
+        return 0;
+    if (!pthread_equal(state->owner, pthread_self()))
+        return AVERROR(EPERM);
+    if (state->finished)
+        return 0;
+    if (state->active) {
+        if (state->end(state->driver, &state->session,
+                       state->receipt.lease) != VA_STATUS_SUCCESS)
+            return AVERROR(EIO);
+        state->active = false;
+        av_frame_unref(state->held_frame);
+    }
+    if (!state->closed) {
+        if (state->close(state->driver, &state->session) != VA_STATUS_SUCCESS)
+            return AVERROR(EIO);
+        state->closed = true;
+    }
+    if (state->failed || state->seen != (1U << state->nb_outputs) - 1 ||
+        state->pool->used != state->nb_outputs)
+        err = AVERROR_INVALIDDATA;
+    else
+        state->finished = true;
+    return err;
+}
+
+int ff_vaapi_decode_observer_result(AVCodecContext *avctx,
+                                    VAAPIObserverResult *result)
+{
+    VAAPIDecodeContext *ctx;
+    VAAPIObserverState *state;
+
+    if (!avctx || !avctx->internal || !avctx->internal->hwaccel_priv_data ||
+        !result)
+        return AVERROR(EINVAL);
+    ctx = avctx->internal->hwaccel_priv_data;
+    state = ctx->observer;
+    if (!state || !state->finished || !state->closed || state->active ||
+        !pthread_equal(state->owner, pthread_self()))
+        return AVERROR(EINVAL);
+    *result = state->result;
+    return 0;
+}
+
+void ff_vaapi_decode_observer_flush(AVCodecContext *avctx)
+{
+    int err = ff_vaapi_decode_observer_finish(avctx);
+    if (err < 0)
+        av_log(avctx, AV_LOG_ERROR,
+               "VA reference-content observer refused flush cleanup: %s.\n",
+               av_err2str(err));
+}
+

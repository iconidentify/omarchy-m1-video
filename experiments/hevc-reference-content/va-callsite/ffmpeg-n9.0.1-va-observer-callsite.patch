@@ -739,6 +1226,14 @@ int ff_vaapi_decode_uninit(AVCodecContext *avctx)
 {
     VAAPIDecodeContext *ctx = avctx->internal->hwaccel_priv_data;
     VAStatus vas;
+    int observer_err = ff_vaapi_decode_observer_finish(avctx);
+
+    if (ctx->observer && ctx->observer->active) {
+        av_log(avctx, AV_LOG_ERROR,
+               "VA reference-content observer still retains a surface; "
+               "refusing context destruction.\n");
+        return observer_err < 0 ? observer_err : AVERROR(EIO);
+    }
 
     if (ctx->va_context != VA_INVALID_ID) {
         vas = vaDestroyContext(ctx->hwctx->display, ctx->va_context);
@@ -757,5 +1252,6 @@ int ff_vaapi_decode_uninit(AVCodecContext *avctx)
         }
     }
 
-    return 0;
+    vaapi_observer_free(&ctx->observer);
+    return observer_err;
 }

+static int vaapi_observer_publish_report(const char *path,
+                                         const char *json, size_t json_size)
+{
+    char *temporary = NULL;
+    int fd = -1, err = 0;
+
+    if (!path || !*path)
+        return AVERROR(EINVAL);
+    temporary = av_asprintf("%s.tmp.XXXXXX", path);
+    if (!temporary)
+        return AVERROR(ENOMEM);
+    fd = mkostemp(temporary, O_CLOEXEC);
+    if (fd < 0) {
+        err = AVERROR(errno);
+        goto out;
+    }
+    if (fchmod(fd, S_IRUSR | S_IWUSR) < 0) {
+        err = AVERROR(errno);
+        goto out;
+    }
+    err = vaapi_observer_write_all(fd, json, json_size);
+    if (err < 0)
+        goto out;
+    if (fsync(fd) < 0) {
+        err = AVERROR(errno);
+        goto out;
+    }
+    if (close(fd) < 0) {
+        err = AVERROR(errno);
+        fd = -1;
+        goto out;
+    }
+    fd = -1;
+    if (renameat2(AT_FDCWD, temporary, AT_FDCWD, path,
+                  RENAME_NOREPLACE) < 0) {
+        err = AVERROR(errno);
+        goto out;
+    }
+
+out:
+    if (fd >= 0 && close(fd) < 0 && !err)
+        err = AVERROR(errno);
+    if (temporary && unlink(temporary) < 0 && errno != ENOENT && !err)
+        err = AVERROR(errno);
+    av_free(temporary);
+    return err;
+}

+        uint64_t elapsed_ns, before_ns, after_ns;
+        struct VAContentIdentity identity;
+        struct VAContentProvenance provenance;
+        unsigned char bytes[VA_OBSERVER_BYTES];
+    } slot[VA_OBSERVER_SLOTS];
+};
+
+typedef VAStatus (*VAObserverOpen)(VADriverContextP, VAContextID,

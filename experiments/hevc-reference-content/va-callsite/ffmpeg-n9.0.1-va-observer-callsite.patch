+int ff_vaapi_decode_observer_write_report(AVCodecContext *avctx,
+                                          const char *path)
+{
+    VAAPIObserverResult result;
+    char *json = NULL;
+    size_t json_size = 0;
+    int err;
+
+    err = ff_vaapi_decode_observer_finish(avctx);
+    if (err < 0)
+        return err;
+    err = ff_vaapi_decode_observer_result(avctx, &result);
+    if (err < 0)
+        return err;
+    err = vaapi_observer_report_json(&result, &json, &json_size);
+    if (err < 0)
+        return err;
+    err = vaapi_observer_publish_report(path, json, json_size);
+    av_free(json);
+    return err;
+}

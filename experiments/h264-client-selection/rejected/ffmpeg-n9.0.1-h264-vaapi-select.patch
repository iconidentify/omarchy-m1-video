diff -u -N -r /tmp/ffmpeg-n901-src/libavcodec/vaapi_h264.c /tmp/ffmpeg-n901-work3/libavcodec/vaapi_h264.c
--- libavcodec/vaapi_h264.c	2026-09-17	20:16:19.952532951	+0000
+++ libavcodec/vaapi_h264.c	2026-09-17	20:18:19.520975366	+0000
@@ -244,6 +244,9 @@

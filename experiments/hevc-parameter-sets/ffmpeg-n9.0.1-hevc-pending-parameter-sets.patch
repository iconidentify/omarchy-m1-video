+/* Read sps_video_parameter_set_id and sps_seq_parameter_set_id without
+ * needing the VPS and without logging. */
+static int sps_peek_ids(const GetBitContext *gb, unsigned *vps_id,
+                        unsigned *sps_id)
+{
+    GetBitContext gbc = *gb;
+    uint8_t profile_present[HEVC_MAX_SUB_LAYERS], level_present[HEVC_MAX_SUB_LAYERS];
+    int max_sub_layers;
+
+    *vps_id        = get_bits(&gbc, 4);
+    max_sub_layers = get_bits(&gbc, 3) + 1;
+    /* The layout of a multi-layer extension SPS comes from its VPS. */
+    if (max_sub_layers > HEVC_MAX_SUB_LAYERS)
+        return AVERROR_INVALIDDATA;
+    skip_bits1(&gbc);             // sps_temporal_id_nesting_flag
+    skip_bits_long(&gbc, 88 + 8); // general profile/tier and general_level_idc
+    for (int i = 0; i < max_sub_layers - 1; i++) {
+        profile_present[i] = get_bits1(&gbc);
+        level_present[i]   = get_bits1(&gbc);
+    }
+    if (max_sub_layers > 1)
+        skip_bits(&gbc, 2 * (8 - (max_sub_layers - 1)));
+    for (int i = 0; i < max_sub_layers - 1; i++)
+        skip_bits_long(&gbc, 88 * profile_present[i] + 8 * level_present[i]);
+
+    *sps_id = get_ue_golomb_long(&gbc);
+    if (*sps_id >= HEVC_MAX_SPS_COUNT || get_bits_left(&gbc) < 0)
+        return AVERROR_INVALIDDATA;
+    return 0;
+}

+/* Parse a pending SPS unless it already failed against the VPS now holding its
+ * VPS id. Returns 1 while that VPS is absent. */
+static int resolve_pending_sps(HEVCParamSets *ps, AVCodecContext *avctx,
+                               unsigned sps_id)
+{
+    const HEVCPendingPS *p = ps->pending_sps[sps_id];
+    const HEVCVPS *vps;
+    GetBitContext gb;
+
+    if (!p)
+        return 0;
+    vps = ps->vps_list[p->dep_id];
+    if (!vps)
+        return 1;
+    if (p->failed_dep == vps)
+        return 0;
+
+    /* A successful parse releases the slot's reference. */
+    p = av_refstruct_ref_c(p);
+    if (init_get_bits(&gb, p->data, p->size_bits) >= 0) {
+        skip_bits_long(&gb, p->bit_start);
+        ff_hevc_decode_nal_sps(&gb, avctx, ps, p->nuh_layer_id, p->apply_defdispwin);
+    }
+    av_refstruct_unref(&p);
+    return 0;
+}
+
+/* Same as resolve_pending_sps() for a PPS and its SPS. */
+static int resolve_pending_pps(HEVCParamSets *ps, AVCodecContext *avctx,
+                               unsigned pps_id)
+{
+    const HEVCPendingPS *p = ps->pending_pps[pps_id];
+    const HEVCSPS *sps;
+    GetBitContext gb;
+
+    if (!p)
+        return 0;
+    sps = ps->sps_list[p->dep_id];
+    if (!sps)
+        return 1;
+    if (p->failed_dep == sps)
+        return 0;
+
+    p = av_refstruct_ref_c(p);
+    if (init_get_bits(&gb, p->data, p->size_bits) >= 0) {
+        skip_bits_long(&gb, p->bit_start);
+        ff_hevc_decode_nal_pps(&gb, avctx, ps);
+    }
+    av_refstruct_unref(&p);
+    return 0;
+}
+
+int ff_hevc_ps_activate(HEVCParamSets *ps, AVCodecContext *avctx,
+                        unsigned pps_id, int irap)
+{
+    const HEVCPendingPS *p;
+    const HEVCPPS *pps;
+    unsigned sps_id;
+
+    if (pps_id >= HEVC_MAX_PPS_COUNT)
+        return 0;
+
+    p      = ps->pending_pps[pps_id];
+    pps    = ps->pps_list[pps_id];
+    sps_id = p ? p->dep_id : pps ? pps->sps_id : HEVC_MAX_SPS_COUNT;
+
+    /* The SPS first: resolving it can move the stored PPS to pending. */
+    if (sps_id < HEVC_MAX_SPS_COUNT &&
+        resolve_pending_sps(ps, avctx, sps_id) && irap) {
+        av_log(avctx, AV_LOG_ERROR,
+               "SPS %u was replaced by an SPS still waiting for VPS %u\n",
+               sps_id, ps->pending_sps[sps_id]->dep_id);
+        return AVERROR_INVALIDDATA;
+    }
+    if (resolve_pending_pps(ps, avctx, pps_id)) {
+        av_log(avctx, AV_LOG_ERROR,
+               "PPS %u was replaced by a PPS still waiting for SPS %u\n",
+               pps_id, ps->pending_pps[pps_id]->dep_id);
+        return AVERROR_INVALIDDATA;
+    }
+    return 0;
+}

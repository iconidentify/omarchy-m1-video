+/* At the first slice of a picture, parse the parameter sets that arrived
+ * before their dependencies and refuse a picture that would use stale ones.
+ * Pictures after a refused IRAP picture are refused until the next IRAP. */
+static int activate_parameter_sets(HEVCContext *s, const GetBitContext *slice_gb)
+{
+    GetBitContext gb = *slice_gb;
+    unsigned pps_id;
+    int ret;
+
+    if (!get_bits1(&gb)) // first_slice_segment_in_pic_flag
+        return 0;
+    if (IS_IRAP(s))
+        skip_bits1(&gb); // no_output_of_prior_pics_flag
+    pps_id = get_ue_golomb_long(&gb);
+
+    ret = ff_hevc_ps_activate(&s->ps, s->avctx, pps_id, IS_IRAP(s));
+    if (IS_IRAP(s)) {
+        s->ps_refused_irap = ret < 0;
+    } else if (ret >= 0 && s->ps_refused_irap) {
+        av_log(s->avctx, AV_LOG_ERROR,
+               "Skipping a picture that follows a refused IRAP picture\n");
+        ret = AVERROR_INVALIDDATA;
+    }
+    return ret;
+}

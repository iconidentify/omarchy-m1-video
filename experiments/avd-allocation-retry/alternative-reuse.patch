 static int avd_h264_start(struct avd_ctx *ctx)
 {
@@ -619,7 +621,7 @@
 	return 0;
 
 err_free_ctx:
-	kfree(h264_ctx);
+	avd_h264_stop(ctx);
 	ctx->priv = NULL;
 	return ret;
 }
